generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  email            String   @unique
  password         String
  role             String
  registrationYear String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Family {
  id              String                 @id @default(cuid())
  name            String
  pere            String
  mere            String
  memberCount     Int
  year            String
  password        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt
  members         FamilyMember[]
  attendanceLists FamilyAttendanceList[]
}

model FamilyMember {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String
  role      String?  @default("Member")
  year      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FamilyAttendanceList {
  id             String    @id @default(cuid())
  familyId       String
  family         Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  year           String
  quarter        String    @default("Q1")
  attendanceGrid String    @default("{}")
  summaryData    String    @default("{}")
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  publishedBy    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([familyId, year, quarter])
}

model Member {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  email            String?
  phone            String?
  joinDate         String?
  baptismDate      String?
  address          String?
  pastor           String?
  churchElder      String?
  isCouncil        Boolean  @default(false)
  isDeacon         Boolean  @default(false)
  isDeaconess      Boolean  @default(false)
  position         String?
  responsibilities String?
  year             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isBaptized       Boolean  @default(false)
}

model Choir {
  id          String   @id @default(cuid())
  name        String
  leaderName  String
  memberNames String[] @default([])
  year        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id         String   @id @default(cuid())
  name       String
  leaderName String
  activities String?
  year       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Finance {
  id          String   @id @default(cuid())
  type        String
  category    String
  amount      Float
  date        String
  description String?
  year        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inventory {
  id          String   @id @default(cuid())
  type        String
  name        String
  count       Int?
  description String?
  issuedTo    String?
  date        String
  year        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String
  date      String
  published Boolean  @default(false)
  fileName  String?
  fileData  String?
  year      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteSermon {
  id          String   @id @default(cuid())
  title       String
  speaker     String
  date        String
  category    String
  scripture   String
  description String
  videoUrl    String
  audioUrl    String
  thumbnail   String
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemConfig {
  id                  String   @id @default("global")
  blockLogin          Boolean  @default(false)
  blockRegister       Boolean  @default(false)
  availableYears      String[] @default(["2024-2025"])
  blockedYears        String[] @default([])
  restrictNewAccounts Boolean  @default(false)
  restrictOldAccounts Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model Report {
  id         String   @id @default(cuid())
  title      String
  status     String
  type       String
  year       String
  createdAt  DateTime @default(now())
  date       String
  pdfData    String
  total      Int
  attendance Int
  pdfUrl     String
}

model Attendance {
  id         String @id @default(cuid())
  date       String
  type       String
  targetId   String
  targetName String
  count      Int
  year       String
}

model SabbathLetter {
  id           String  @id
  name         String
  originChurch String
  district     String
  field        String
  fileName     String
  fileData     String?
  status       String
  year         String
}

model WeekOfPrayer {
  id        String   @id @default(cuid())
  title     String
  date      String
  content   String?
  year      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyProgram {
  id           String   @id @default(cuid())
  day          String
  preacherName String
  prayer       String?
  coordinator  String?
  year         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
